[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=AmitEchoLab.cat
DriverVer=10/29/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DriverCopy=13
[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
AmitEchoLab.sys=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...22000
[Models.NTamd64.10.0...22000]
%DeviceName%=Install,Root\AmitEchoLab

[Install.NT]
CopyFiles=DriverCopy
[DriverCopy]
AmitEchoLab.sys

[Install.NT.Services]
AddService=AmitEchoLab,0x00000002,Service_Inst
[Service_Inst]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AmitEchoLab.sys

[Install.NT.HW]
AddReg=DeviceSecurity
[DeviceSecurity]
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Wdf]
KmdfService=AmitEchoLab,WdfSection
[WdfSection]
KmdfLibraryVersion=1.33

[Strings]
ProviderName="AmitTech Lab"
DiskName="AmitTech Lab Driver"
DeviceName="AmitTech Deferred Software Device"
ServiceName="AmitTech Deferred Request Lab"
